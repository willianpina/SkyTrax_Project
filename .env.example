APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://skytrax:skytrax@postgres:5432/skytrax
REDIS_URL=redis://redis:6379/0
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_TRUSTED_HOSTS=localhost,127.0.0.1,testserver,app,0.0.0.0
API_RATE_LIMIT_PER_MINUTE=120
API_MAX_REQUEST_BYTES=1048576
API_REQUEST_TIMEOUT_SECONDS=30
SCRAPE_USER_AGENT=SkyTraxAnalyticsBot/0.1 (+contact: analytics@example.com)
SCRAPE_RATE_LIMIT_SECONDS=2.0
SCRAPE_TIMEOUT_SECONDS=20
MAX_RETRIES=3
VITE_API_BASE=http://localhost:8000/api
SCRAPY_CONCURRENT_REQUESTS=8
SCRAPY_CONCURRENT_REQUESTS_PER_DOMAIN=4
SCRAPY_DOWNLOAD_DELAY=1.5
SCRAPY_CLOSESPIDER_PAGECOUNT=500
SCRAPY_CLOSESPIDER_ERRORCOUNT=25
SCRAPY_DEPTH_LIMIT=20
EMBEDDING_DIMENSION=384
NLP_ENABLE_EMBEDDINGS=false
NLP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
CRAWL_INTERVAL_HOURS=6
CRAWL_MAX_PAGES=5
NLP_INTERVAL_MINUTES=30
SNAPSHOT_HOURLY_MINUTES=60
SNAPSHOT_DAILY_HOUR=2
INSIGHTS_INTERVAL_HOURS=4
CLEANUP_INTERVAL_HOURS=24
SEMANTIC_SIMILARITY_THRESHOLD=0.12
JOB_RETRY_ATTEMPTS=3
JOB_OVERLAP_LOCK_MINUTES=120
PRIORITY_AIRLINES=british-airways,emirates,qatar-airways,lufthansa,latam-airlines
ALERT_WEBHOOK_URL=
FORECAST_INTERVAL_HOURS=4
ANOMALY_INTERVAL_HOURS=2
ENABLE_POSTGIS=false
